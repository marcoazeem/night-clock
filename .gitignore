# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Light addresses and keys — passed with --dart-define-from-file, never committed
/lights.json

# Background videos are the user's own clips (likely stock footage) — kept
# out of the public repo. The app falls back to the drawn sky without them.
/*.mp4
/*.mov
/assets/video/*.mp4
/*.mov

# iPad build output (rendered glyphs, generated Config.h with the light keys, the app)
# The iPad port is its own repo (marcoazeem/night-clock-ipad), cloned here.
/ipad/

# Electricity bills (account number, meter readings) — private
/stelco*
